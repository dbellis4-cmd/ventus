# Copy to .env.local and fill in values from your Supabase project's Connect dialog.
# These are public application settings, not privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use an sb_publishable_... key. Never use a secret/service-role key or Google tokens.

# Canonical app origin for email callbacks. Defaults to this value in development;
# set explicitly to your HTTPS application origin before any production use.
SITE_URL=http://localhost:3000
