# Copy to .env.local and fill in values from your Supabase project's Connect dialog.
# These are public application settings, not privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use an sb_publishable_... key. Never use a secret/service-role key or Google tokens.

# Canonical app origin for email callbacks. Defaults to this value in development;
# set explicitly to your HTTPS application origin before any production use.
SITE_URL=http://localhost:3000

# Server only. Use separate Google OAuth web credentials and a 32-byte base64 key.
# Keep these and the Supabase secret key out of NEXT_PUBLIC_ variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Dedicated sb_secret_... key for server-side Calendar synchronization.
SUPABASE_SECRET_KEY=
# Required only for the daily recovery endpoint when deployed.
CRON_SECRET=
